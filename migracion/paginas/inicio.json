    {
      "tipo": "h3",
      "texto": "INSPECCIÓN TÉCNICA DE MOTOCLICLETAS",
      "seccion": "0b95263"
    },
    {
      "tipo": "h3",
      "texto": "Especialistas en Inspección y Avalúo Comercial",
      "seccion": "0b95263"
    },
    {
      "tipo": "parrafo",
      "texto": "Nuestro equipo se dedica exclusivamente a la inspección técnica de peritajes y avalúos comerciales. Somos especialistas formados para identificar cada detalle estructural y funcional de motocicletas.",
      "seccion": "0b95263"
    },
    {
      "tipo": "parrafo",
      "texto": "Entendemos que una moto es una inversión y una pasión. Por eso, nuestro personal aplica un criterio técnico riguroso para determinar el estado real y el valor comercial justo de cada unidad en el mercado actual.",
      "seccion": "0b95263"
    },
