# Moto Peritaje — sitio estático (para hosting Apache / LiteSpeed, como el actual).
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Forzar HTTPS y dominio sin www (igual que en WordPress)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://motoperitaje.com/$1 [R=301,L]

# Antiguas rutas de WordPress que ya no existen
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^feed/?$ /blog/ [R=301,L]
RewriteRule ^comments/feed/?$ /blog/ [R=301,L]
RewriteRule ^(.+)/feed/?$ /$1/ [R=301,L]
RewriteRule ^(wp-admin|wp-login\.php) / [R=302,L]

# Slash final obligatorio (como WordPress): /contactanos -> /contactanos/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}/ -d
RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
</IfModule>
