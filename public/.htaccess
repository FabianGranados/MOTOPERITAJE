# Moto Peritaje — sitio estático (para hosting Apache / LiteSpeed, como el actual).
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Forzar HTTPS y dominio sin www (igual que en WordPress)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://motoperitaje.com/$1 [R=301,L]

# Antiguas rutas de WordPress que ya no existen
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^feed/?$ /blog/ [R=301,L]
RewriteRule ^comments/feed/?$ /blog/ [R=301,L]
RewriteRule ^(.+)/feed/?$ /$1/ [R=301,L]
RewriteRule ^(wp-admin|wp-login\.php) / [R=302,L]

# Slash final obligatorio (como WordPress): /contactanos -> /contactanos/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}/ -d
RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# --- Generado por scripts/build.py ---
<IfModule mod_rewrite.c>
# Atajos de WordPress (?p=ID / ?page_id=ID) -> URL definitiva
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=30(&|$)
RewriteRule ^$ /contactanos/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=125(&|$)
RewriteRule ^$ /precio-peritaje-moto/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=960(&|$)
RewriteRule ^$ /todo-lo-que-necesitas-saber-sobre-el-peritaje-de-motos/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=1108(&|$)
RewriteRule ^$ /como-el-peritaje-revela-su-verdadero-precio-en-el-mercado-de-las-motos/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=1154(&|$)
RewriteRule ^$ /importancia-del-peritaje-de-motos-en-casos-de-accidentes/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=1187(&|$)
RewriteRule ^$ /blog/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=1221(&|$)
RewriteRule ^$ /que-tipo-de-informacion-se-recopila-durante-un-peritaje-de-motos/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=1280(&|$)
RewriteRule ^$ /que-documentacion-necesito-para-realizar-un-peritaje-de-motos-en-bogota/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=1367(&|$)
RewriteRule ^$ /politica-de-tratamiento-de-datos/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=1438(&|$)
RewriteRule ^$ /como-preparar-tu-moto-para-un-viaje-seguro-consejos-esenciales/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=1500(&|$)
RewriteRule ^$ /iluminando-el-camino-luces-led-para-motos/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=1540(&|$)
RewriteRule ^$ /las-marcas-de-motos-mas-populares/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=1688(&|$)
RewriteRule ^$ /historia-de-las-motos/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=1724(&|$)
RewriteRule ^$ /importancia-del-equipo-de-proteccion-para-motociclistas/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=1805(&|$)
RewriteRule ^$ /mejores-accesorios-para-motociclistas/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=2395(&|$)
RewriteRule ^$ /agendar-en-linea/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=3032(&|$)
RewriteRule ^$ /guia-de-mantenimiento-preventivo-para-motos-usadas/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=3348(&|$)
RewriteRule ^$ /que-revisar-antes-de-comprar-una-moto-usada-en-bogota/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=3559(&|$)
RewriteRule ^$ /peritaje-de-motos-a-domicilio-en-bogota/? [R=301,L]
# Archivos de WordPress que aún no se migraron (temporal)
RewriteRule ^category/uncategorized/page/[0-9]+/?$ /category/uncategorized/ [R=302,L]
RewriteRule ^author/[^/]+(/page/[0-9]+)?/?$ /blog/ [R=302,L]
RewriteRule ^[0-9]{4}(/[0-9]{2}(/[0-9]{2})?)?/?$ /blog/ [R=302,L]
RewriteRule ^blog/page/[0-9]+/?$ /blog/ [R=302,L]
</IfModule>
