{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "motoperitaje",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": true
	},
	"observability": { "enabled": true }
	// Los dominios (motoperitaje.com y www.motoperitaje.com) se agregan como "routes" con
	// "custom_domain": true cuando el sitio esté listo para reemplazar a WordPress.
}
